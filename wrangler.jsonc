{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "experiencehub",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "PUBLIC_SITE_URL": "https://experiencehub.sharmaprajjwal8848.workers.dev",
    "PUBLIC_SUPABASE_URL": "https://kiuoyvpbkzfdpkmmvmqy.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Hx4uV-tiRqt4vqhM9JuGdQ_urct_myM",
    "OPENROUTER_MODEL": "openrouter/free",
    "SITE_URL": "https://experiencehub.sharmaprajjwal8848.workers.dev",
    "SITE_NAME": "ExperienceHub"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/countries",
      "/countries/*",
      "/experiences",
      "/experiences/*",
      "/restaurants/*",
      "/packages/*",
      "/book/*",
      "/checkout/*",
      "/admin",
      "/admin/*",
      "/api/*",
      "/catalogue-sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
