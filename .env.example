# Public browser-safe Supabase configuration.
#
# Find these values in your Supabase project under:
# Project Settings → Data API (project URL) and API Keys (publishable/anon key).
#
# The project URL and anonymous key are designed for browser use. They do not
# make database rows public by themselves: security depends on PostgreSQL Row
# Level Security (RLS) and the policies in supabase/migrations/.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Never place a Supabase service-role key in this file or in browser code.
# Service-role keys bypass RLS, must never use the PUBLIC_ prefix, and belong
# only in a protected server-side secret store if a future milestone needs one.

# Server-only OpenRouter recommendation assistant configuration.
#
# OPENROUTER_API_KEY must never use the PUBLIC_ prefix or appear in browser
# JavaScript. Choose a currently available low-cost model that supports
# structured outputs; the application deliberately does not hard-code one.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenRouter app-attribution values. Use the public production URL and
# a short site name. These values are not secrets.
SITE_URL=
SITE_NAME=

# Google Analytics and Tag Manager identifiers are intentionally public.
# When both are configured, Google Tag Manager takes precedence and direct
# GA4 initialisation is disabled to prevent duplicate tracking.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=

# Stripe checkout configuration.
#
# PAYMENT_MODE defaults to "dummy". Use "payment-link" or "checkout-session"
# only after the matching package records and Stripe test configuration are
# ready. PUBLIC_SITE_URL must be the public origin with no path.
PAYMENT_MODE=
PUBLIC_SITE_URL=

# The publishable key is intentionally browser-safe. ExperienceHub currently
# redirects to Stripe-hosted Checkout and does not need Stripe.js, but this
# variable prepares a future browser integration.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only Stripe credentials. Never add PUBLIC_ to either name and never
# commit real test or live values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
