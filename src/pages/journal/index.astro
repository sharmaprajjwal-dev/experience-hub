---
import ButtonLink from '../../components/ButtonLink.astro';
import JournalCard from '../../components/JournalCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPublishedJournalEntries,
  journalCategories,
} from '../../lib/journal';

const entries = await getPublishedJournalEntries();
const featuredEntry = entries.find(({ data }) => data.featured) ?? entries[0];
const recentEntries = featuredEntry
  ? entries.filter(({ id }) => id !== featuredEntry.id)
  : [];
const activeCategories = journalCategories.filter((category) =>
  entries.some(({ data }) => data.category === category),
);
const activeCountries = [
  ...new Set(
    entries.map(({ data }) =>
      data.country.id
        .split('-')
        .map((word) => word[0].toUpperCase() + word.slice(1))
        .join(' '),
    ),
  ),
];
---

<BaseLayout
  title="Journal | Practical dining guides from ExperienceHub"
  description="Useful, honest guidance for choosing brunch packages, planning date nights, and booking curated dining experiences."
  canonicalURL="/journal"
>
  <SiteHeader />
  <main>
    <section class="border-b border-line bg-surface">
      <div class="site-container py-20 sm:py-28">
        <div class="reading-width">
          <p class="eyebrow">ExperienceHub Journal</p>
          <h1 class="mt-5 display-title text-[clamp(4rem,9vw,7.5rem)] text-balance">
            Notes for gathering well.
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
            Practical guides for choosing dining experiences with more clarity
            and fewer assumptions.
          </p>
          <a class="text-link mt-7" href="/journal/rss.xml">
            Subscribe via RSS
          </a>
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="site-container">
        <SectionHeading
          eyebrow="Featured article"
          title="A considered place to begin."
        />
        {
          featuredEntry ? (
            <div class="mt-12 lg:mt-16">
              <JournalCard entry={featuredEntry} featured />
            </div>
          ) : (
            <div class="empty-state mt-10">
              <h2 class="font-display text-2xl">No published articles yet</h2>
              <p class="mt-2 text-muted">
                The first Journal guide will appear here when it is ready.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <section class="section-rule section-shell bg-surface">
      <div class="site-container">
        <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
          <div>
            <p class="eyebrow">Browse the Journal</p>
            <h2 class="mt-4 font-display text-3xl tracking-[-0.03em]">
              Topics and places
            </h2>
          </div>
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <h3 class="text-sm font-semibold">Categories</h3>
              {
                activeCategories.length > 0 ? (
                  <ul class="mt-4 flex flex-wrap gap-2" role="list">
                    {activeCategories.map((category) => (
                      <li class="rounded-full border border-line bg-background px-3 py-1.5 text-xs font-semibold text-muted">
                        {category}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-3 text-sm text-muted">No categories yet.</p>
                )
              }
            </div>
            <div>
              <h3 class="text-sm font-semibold">Countries</h3>
              {
                activeCountries.length > 0 ? (
                  <ul class="mt-4 flex flex-wrap gap-2" role="list">
                    {activeCountries.map((country) => (
                      <li class="rounded-full border border-line bg-background px-3 py-1.5 text-xs font-semibold text-muted">
                        {country}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-3 text-sm text-muted">No countries yet.</p>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-rule section-shell">
      <div class="site-container">
        <SectionHeading
          eyebrow="Recent articles"
          title="Useful guidance, without the filler."
          description="Original editorial guidance based on practical planning principles. Business-specific details remain clearly identified as concepts until confirmed."
        />
        {
          recentEntries.length > 0 ? (
            <div class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-16">
              {recentEntries.map((entry) => <JournalCard entry={entry} />)}
            </div>
          ) : (
            <div class="empty-state mt-10">
              <h2 class="font-display text-2xl">More stories are being prepared</h2>
              <p class="mt-2 text-muted">
                There are no additional published articles at the moment.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <section class="section-rule section-shell bg-ink text-surface">
      <div class="site-container flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <p class="text-xs font-bold tracking-[0.2em] text-stone-400 uppercase">
            Continue exploring
          </p>
          <h2 class="mt-5 font-display text-4xl leading-tight tracking-[-0.035em] sm:text-5xl">
            Put the guidance into context.
          </h2>
          <p class="mt-5 max-w-xl leading-7 text-stone-300">
            Compare the current demonstration experiences and see how each
            package explains its audience, duration, and inclusions.
          </p>
        </div>
        <ButtonLink href="/experiences" variant="light">
          Explore experiences
        </ButtonLink>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
