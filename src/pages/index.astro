---
import ButtonLink from '../components/ButtonLink.astro';
import CountryCard from '../components/CountryCard.astro';
import CountrySelector from '../components/CountrySelector.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import JournalCard from '../components/JournalCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getContentGraph,
  getCountryForRestaurant,
  getExperiencesForRestaurants,
  formatRestaurantLabel,
  getRestaurantForExperience,
  getRestaurantsForCountry,
} from '../lib/content';
import { getPublishedJournalEntries } from '../lib/journal';

export const prerender = false;

const title = 'ExperienceHub | Remarkable dining, rooted in place';
const description =
  'Discover curated restaurant experiences and thoughtful dining packages in Nepal and New Zealand.';
const graph = await getContentGraph();
const journalEntries = await getPublishedJournalEntries();
const featuredExperiences = graph.experiences.filter(
  ({ data }) => data.featured,
);
const leadCountry = graph.countries[0];
const leadRestaurants = leadCountry
  ? getRestaurantsForCountry(graph, leadCountry.data.slug)
  : [];
const leadExperiences = getExperiencesForRestaurants(graph, leadRestaurants);
const heroExperience =
  leadExperiences.find(({ data }) => data.featured) ?? featuredExperiences[0];
const heroUsesImage = heroExperience?.data.heroImage.startsWith('http') ?? false;
const heroRestaurant = heroExperience
  ? getRestaurantForExperience(graph, heroExperience)
  : undefined;
const heroCountry = heroRestaurant
  ? getCountryForRestaurant(graph, heroRestaurant)
  : undefined;
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main>
    <section class="overflow-hidden">
      <div
        class="site-container grid min-h-[calc(100svh-5rem)] items-center gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-20"
      >
        <div class="hero-enter max-w-3xl">
          <p class="eyebrow">
            {graph.countries.map(({ data }) => data.name).join(' · ')}
          </p>
          <h1 class="display-title mt-6 text-[clamp(3.8rem,8vw,7.5rem)] text-balance">
            Gather around something remarkable.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-muted sm:text-xl">
            ExperienceHub brings together distinctive restaurants, local
            character, and considered packages for occasions worth remembering.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <ButtonLink href="#experiences">Explore experiences</ButtonLink>
            <ButtonLink href="#how-it-works" variant="secondary">
              How it works
            </ButtonLink>
          </div>
        </div>

        <div
          class:list={[
            'media-frame hero-enter hero-enter--delay aspect-[4/5] rounded-[1.5rem] sm:aspect-[5/4] lg:aspect-[4/5]',
            heroUsesImage
              ? false
              : heroExperience?.data.heroImage ?? 'media-journal',
          ]}
          role="img"
          aria-label={`Atmospheric placeholder artwork for ${heroExperience?.data.name ?? 'a featured dining experience'}`}
        >
          {
            heroUsesImage && heroExperience && (
              <img
                class="absolute inset-0 h-full w-full object-cover"
                src={heroExperience.data.heroImage}
                alt={heroExperience.data.imageAlt ?? heroExperience.data.name}
                width={heroExperience.data.imageWidth ?? 1200}
                height={heroExperience.data.imageHeight ?? 1500}
                decoding="async"
              />
            )
          }
          <div
            class="absolute right-[12%] bottom-[11%] z-10 max-w-64 rounded-xl border border-white/30 bg-black/20 p-5 text-white backdrop-blur-md"
          >
            <p class="text-[0.65rem] font-bold tracking-[0.18em] uppercase">
              Featured in {heroRestaurant?.data.city ?? 'the collection'}
            </p>
            <p class="mt-2 font-display text-2xl leading-tight">
              {heroExperience?.data.name ?? 'A remarkable dining experience'}
              {heroRestaurant && ` at ${heroRestaurant.data.name}`}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="countries" class="section-rule section-shell bg-surface">
      <div class="site-container">
        <SectionHeading
          eyebrow="The collection"
          title="Distinct places. Distinct ways to gather."
          description="Explore every active ExperienceHub destination through local restaurants, curated experiences, and thoughtful packages."
        />
        <div class="mt-9">
          <CountrySelector />
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-16">
          {
            graph.countries.map(({ data }) => {
              const restaurants = getRestaurantsForCountry(graph, data.slug);
              const location =
                restaurants.map(({ data }) => data.city).join(' · ') ||
                'Collection in development';

              return (
                <CountryCard
                  country={data.name}
                  countrySlug={data.slug}
                  location={location}
                  description={data.shortDescription}
                  mediaClass={data.heroImage}
                  href={`/countries/${data.slug}`}
                />
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="experiences" class="section-shell">
      <div class="site-container">
        <SectionHeading
          eyebrow="Featured experiences"
          title="Choose the feeling, not just the table."
          description="Each experience pairs a distinctive setting with packages shaped around who you are gathering with."
        />
        <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:mt-16">
          {
            featuredExperiences.map((experience) => {
              const restaurant = getRestaurantForExperience(graph, experience);
              const country = restaurant
                ? getCountryForRestaurant(graph, restaurant)
                : undefined;
              const packages = graph.packages.filter(
                ({ data }) => data.experienceSlug.id === experience.data.slug,
              );

              return (
                <ExperienceCard
                  eyebrow={`${restaurant?.data.city ?? 'Destination'} · ${country?.data.name ?? 'ExperienceHub'}`}
                  title={experience.data.name}
                  restaurant={restaurant ? formatRestaurantLabel(restaurant) : 'Restaurant to be announced'}
                  description={experience.data.shortDescription}
                  packageName={`${packages.length} ${packages.length === 1 ? 'package' : 'packages'} available`}
                  mediaClass={experience.data.heroImage}
                  href={`/experiences/${experience.data.slug}`}
                />
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section-rule section-shell bg-surface">
      <div class="site-container">
        <SectionHeading
          eyebrow="How it works"
          title="A memorable table in three simple steps."
          centred
        />
        <ol class="mt-14 grid gap-10 md:grid-cols-3" role="list">
          <li class="border-t border-line pt-6">
            <span class="font-display text-3xl text-accent">01</span>
            <h3 class="mt-8 text-lg font-semibold">Explore by place</h3>
            <p class="mt-3 leading-7 text-muted">
              Begin with a country and discover restaurants chosen for character,
              care, and a strong sense of place.
            </p>
          </li>
          <li class="border-t border-line pt-6">
            <span class="font-display text-3xl text-accent">02</span>
            <h3 class="mt-8 text-lg font-semibold">Find your experience</h3>
            <p class="mt-3 leading-7 text-muted">
              Choose the mood and occasion, from a generous family brunch to an
              intimate dinner for two.
            </p>
          </li>
          <li class="border-t border-line pt-6">
            <span class="font-display text-3xl text-accent">03</span>
            <h3 class="mt-8 text-lg font-semibold">Select a package</h3>
            <p class="mt-3 leading-7 text-muted">
              Pick the package that fits your gathering. Booking will arrive in
              a later milestone.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section id="journal" class="section-shell">
      <div class="site-container">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <SectionHeading
            eyebrow="From the journal"
            title="Notes on food, place, and gathering."
          />
          <a class="text-link shrink-0" href="/journal">
            Read the journal
          </a>
        </div>

        {
          journalEntries.length > 0 ? (
            <div
              id="journal-stories"
              class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-16"
            >
              {journalEntries.slice(0, 2).map((entry) => (
                <JournalCard entry={entry} />
              ))}
            </div>
          ) : (
            <div class="empty-state mt-10">
              <h3 class="font-display text-2xl">Journal stories are coming soon</h3>
              <p class="mt-2 text-muted">
                Practical guides will appear here as they are published.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <section id="explore" class="section-rule bg-accent text-surface">
      <div
        class="site-container grid gap-10 py-20 md:grid-cols-[1fr_auto] md:items-end lg:py-24"
      >
        <div class="max-w-3xl">
          <p class="text-xs font-bold tracking-[0.2em] text-white/75 uppercase">
            Your next table
          </p>
          <h2
            class="mt-5 font-display text-4xl leading-tight tracking-[-0.04em] text-balance sm:text-6xl"
          >
            Begin with a place. Leave with a story.
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-white/80">
            Explore the first ExperienceHub collection across Nepal and New
            Zealand.
          </p>
        </div>
        <ButtonLink variant="light" href="/countries">
          Explore countries
        </ButtonLink>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
