---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  catalogueResources,
  resourceLabels,
  type CatalogueRecord,
  type CatalogueResource,
} from '../../lib/admin-catalogue';

export const prerender = false;

const supabase = Astro.locals.supabase!;
const results = await Promise.all(
  catalogueResources.map(async (resource) => {
    const [countResult, recentResult] = await Promise.all([
      supabase.from(resource).select('id', { count: 'exact', head: true }),
      supabase
        .from(resource)
        .select('id,name,slug,active,updated_at')
        .order('updated_at', { ascending: false })
        .limit(3),
    ]);
    return {
      resource,
      count: countResult.count ?? 0,
      recent: (recentResult.data ?? []) as CatalogueRecord[],
      error: countResult.error ?? recentResult.error,
    };
  }),
);

const loadFailed = results.some(({ error }) => error);
const recentRecords = results
  .flatMap(({ resource, recent }) =>
    recent.map((record) => ({ resource, record })),
  )
  .sort(
    (a, b) =>
      new Date(String(b.record.updated_at)).getTime() -
      new Date(String(a.record.updated_at)).getTime(),
  )
  .slice(0, 6);
---

<AdminLayout
  title="Overview"
  description="Manage the ExperienceHub catalogue."
  current="overview"
>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow">Catalogue overview</p>
      <h1 class="mt-4 font-display text-5xl tracking-[-0.04em] sm:text-6xl">
        Shape the next experience.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        Manage the country-to-package journey without changing application
        code.
      </p>
    </div>
    <a class="button button--primary" href="/admin/catalogue/packages/new">
      Add package
    </a>
  </div>

  {
    loadFailed && (
      <div class="mt-8 rounded-xl border border-error/30 bg-error/5 p-4 text-sm text-error">
        Some catalogue totals could not be loaded. Apply the Milestone 9
        database migration and try again.
      </div>
    )
  }

  <section class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Catalogue totals">
    {
      results.map(({ resource, count }) => (
        <a
          class="card block p-6 hover:border-accent"
          href={`/admin/catalogue/${resource}`}
        >
          <p class="eyebrow">{resourceLabels[resource].plural}</p>
          <p class="mt-4 font-display text-5xl">{count}</p>
          <p class="mt-3 text-sm text-muted">View and manage records</p>
        </a>
      ))
    }
  </section>

  <section class="mt-12 rounded-[1.5rem] border border-line bg-surface">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line p-6 sm:p-8">
      <div>
        <p class="eyebrow">Recently updated</p>
        <h2 class="mt-3 font-display text-3xl">Latest catalogue work</h2>
      </div>
    </div>
    {
      recentRecords.length > 0 ? (
        <ul class="divide-y divide-line">
          {recentRecords.map(({ resource, record }) => (
            <li class="flex flex-wrap items-center justify-between gap-4 p-5 sm:px-8">
              <div>
                <p class="font-semibold">{record.name}</p>
                <p class="mt-1 text-xs text-muted">
                  {resourceLabels[resource as CatalogueResource].singular} ·{' '}
                  {record.active ? 'Active' : 'Inactive'}
                </p>
              </div>
              <a
                class="text-link"
                href={`/admin/catalogue/${resource}/${record.id}`}
              >
                Edit
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="p-8 text-sm text-muted">
          No database records are available yet.
        </div>
      )
    }
  </section>
</AdminLayout>
