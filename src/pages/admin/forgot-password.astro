---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import { isEmailAddress } from '../../lib/auth';

export const prerender = false;

const supabase = Astro.locals.supabase;
let errorMessage: string | undefined;
let statusMessage: string | undefined;
let email = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  email = String(formData.get('email') ?? '').trim().toLowerCase();

  if (!supabase) {
    errorMessage =
      'Password recovery is not configured for this environment.';
  } else if (!isEmailAddress(email)) {
    errorMessage = 'Enter a valid email address.';
  } else {
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/admin/reset-password', Astro.url.origin).toString(),
    });

    if (error) {
      errorMessage =
        error.code === 'over_request_rate_limit'
          ? 'Too many recovery requests were made. Please wait and try again.'
          : 'Password recovery could not be started. Please try again.';
    } else {
      statusMessage =
        'If an eligible account exists, password-reset instructions have been sent.';
      email = '';
    }
  }
}
---

<AdminAuthLayout
  title="Reset administrator password | ExperienceHub"
  description="Request secure password-reset instructions for an ExperienceHub administrator account."
  eyebrow="Password recovery"
  heading="Recover access."
  introduction="Enter the email address associated with the administrator account."
>
  {
    errorMessage && (
      <div class="rounded-xl border border-error/35 bg-error/8 p-4 text-sm leading-6 text-error" role="alert">
        {errorMessage}
      </div>
    )
  }
  {
    statusMessage && (
      <div class="rounded-xl border border-success/35 bg-success/8 p-4 text-sm leading-6 text-success" role="status">
        {statusMessage}
      </div>
    )
  }

  <form class="mt-7 space-y-5" method="post">
    <div>
      <label class="block text-sm font-semibold" for="email">Email address</label>
      <input
        class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-4 text-ink"
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        value={email}
      />
    </div>
    <button class="button button--primary w-full" type="submit">
      Send reset instructions
    </button>
  </form>

  <a class="text-link mt-7" href="/admin/login">Return to sign in</a>
</AdminAuthLayout>
