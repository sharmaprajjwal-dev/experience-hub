---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  CATALOGUE_IMAGE_ACCEPT,
  MAX_CATALOGUE_IMAGE_BYTES,
  catalogueImageSections,
} from '../../../lib/storage';

export const prerender = false;

const maxImageSizeMb = MAX_CATALOGUE_IMAGE_BYTES / 1024 / 1024;
---

<BaseLayout
  title="Image storage test | ExperienceHub"
  description="Private ExperienceHub image storage test tool."
  canonicalURL="/admin/storage"
  robots="noindex, nofollow"
>
  <header class="border-b border-line bg-surface">
    <div class="site-container flex min-h-20 flex-wrap items-center justify-between gap-4 py-4">
      <a
        class="font-display text-xl tracking-[-0.03em]"
        href="/admin"
        aria-label="Return to administrator dashboard"
      >
        ExperienceHub
      </a>
      <div class="flex items-center gap-3">
        <a class="button button--secondary" href="/admin">Dashboard</a>
        <form action="/admin/logout" method="post">
          <button class="button button--secondary" type="submit">
            Sign out
          </button>
        </form>
      </div>
    </div>
  </header>

  <main>
    <section class="border-b border-line bg-surface">
      <div class="site-container py-14 sm:py-20">
        <p class="eyebrow">Administrator · storage test</p>
        <h1 class="mt-5 max-w-4xl font-display text-[clamp(2.8rem,6vw,5.25rem)] leading-[0.98] tracking-[-0.045em] text-balance">
          Test one catalogue image safely.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
          This temporary tool verifies the reusable upload foundation. It does
          not create or edit catalogue records.
        </p>
      </div>
    </section>

    <section class="section-shell">
      <div class="site-container grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div>
          <p class="eyebrow">Upload rules</p>
          <h2 class="mt-4 font-display text-4xl tracking-[-0.035em]">
            Prepare an image
          </h2>
          <ul class="mt-6 grid gap-3 text-sm leading-6 text-muted">
            <li>JPEG, PNG, or WebP only</li>
            <li>{maxImageSizeMb} MB maximum file size</li>
            <li>At least 640 × 360 pixels and no side above 8,000 pixels</li>
            <li>WebP is encouraged; automatic compression is not included</li>
          </ul>
        </div>

        <div class="rounded-[1.5rem] border border-line bg-surface p-6 shadow-sm sm:p-8">
          <form id="storage-test-form" class="grid gap-6">
            <div>
              <label class="block text-sm font-semibold" for="storage-section">
                Catalogue section
              </label>
              <select
                class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-4 text-ink"
                id="storage-section"
                name="section"
                required
              >
                {
                  catalogueImageSections.map((section) => (
                    <option value={section}>
                      {section[0].toUpperCase() + section.slice(1)}
                    </option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold" for="storage-alt-text">
                Descriptive alt text
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-4 text-ink"
                id="storage-alt-text"
                name="altText"
                type="text"
                maxlength="180"
                autocomplete="off"
                placeholder="A shared brunch table set for four guests"
                required
              />
              <p class="mt-2 text-xs leading-5 text-muted">
                Recorded here for preview only. A later catalogue editor will
                save it beside the object path.
              </p>
            </div>

            <div>
              <label class="block text-sm font-semibold" for="storage-image">
                Image file
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-3 py-2 text-sm text-ink file:mr-4 file:rounded-full file:border-0 file:bg-accent file:px-4 file:py-2 file:text-sm file:font-bold file:text-white"
                id="storage-image"
                name="image"
                type="file"
                accept={CATALOGUE_IMAGE_ACCEPT}
                required
              />
            </div>

            <figure
              id="storage-preview"
              class="hidden overflow-hidden rounded-[1.25rem] border border-line bg-background"
            >
              <img
                id="storage-preview-image"
                class="aspect-[16/10] w-full object-cover"
                alt=""
                width="1600"
                height="1000"
              />
              <figcaption
                id="storage-preview-caption"
                class="border-t border-line px-4 py-3 text-xs text-muted"
              >
              </figcaption>
            </figure>

            <p
              id="storage-status"
              class="min-h-6 text-sm leading-6 text-muted"
              role="status"
              aria-live="polite"
            >
              Choose an image to preview it before uploading.
            </p>

            <button
              id="storage-upload-button"
              class="button button--primary justify-center disabled:cursor-not-allowed disabled:opacity-50"
              type="submit"
              disabled
            >
              Upload test image
            </button>
          </form>

          <section
            id="storage-result"
            class="mt-8 hidden border-t border-line pt-8"
            aria-labelledby="storage-result-title"
          >
            <p class="eyebrow">Uploaded object</p>
            <h2
              id="storage-result-title"
              class="mt-3 font-display text-2xl tracking-[-0.025em]"
            >
              Storage test complete
            </h2>
            <img
              id="storage-result-image"
              class="mt-5 aspect-[16/10] w-full rounded-[1.25rem] border border-line object-cover"
              alt=""
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
            <dl class="mt-5 grid gap-3 text-sm">
              <div>
                <dt class="font-bold">Stored path</dt>
                <dd id="storage-result-path" class="mt-1 break-all text-muted">
                </dd>
              </div>
              <div>
                <dt class="font-bold">Public image URL</dt>
                <dd class="mt-1">
                  <a
                    id="storage-result-url"
                    class="text-link break-all"
                    target="_blank"
                    rel="noreferrer"
                  >
                    Open uploaded image
                  </a>
                </dd>
              </div>
            </dl>
            <button
              id="storage-delete-button"
              class="button button--secondary mt-6 disabled:cursor-not-allowed disabled:opacity-50"
              type="button"
            >
              Delete test upload
            </button>
          </section>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#storage-test-form');
  const fileInput =
    document.querySelector<HTMLInputElement>('#storage-image');
  const altInput =
    document.querySelector<HTMLInputElement>('#storage-alt-text');
  const uploadButton = document.querySelector<HTMLButtonElement>(
    '#storage-upload-button',
  );
  const deleteButton = document.querySelector<HTMLButtonElement>(
    '#storage-delete-button',
  );
  const status = document.querySelector<HTMLElement>('#storage-status');
  const preview = document.querySelector<HTMLElement>('#storage-preview');
  const previewImage =
    document.querySelector<HTMLImageElement>('#storage-preview-image');
  const previewCaption = document.querySelector<HTMLElement>(
    '#storage-preview-caption',
  );
  const result = document.querySelector<HTMLElement>('#storage-result');
  const resultImage =
    document.querySelector<HTMLImageElement>('#storage-result-image');
  const resultPath =
    document.querySelector<HTMLElement>('#storage-result-path');
  const resultUrl =
    document.querySelector<HTMLAnchorElement>('#storage-result-url');

  const allowedTypes = new Set(['image/jpeg', 'image/png', 'image/webp']);
  const maxBytes = 5 * 1024 * 1024;
  let previewUrl: string | null = null;
  let imageWidth = 1600;
  let imageHeight = 1000;
  let uploadedPath: string | null = null;

  function setStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('text-error', isError);
    status.classList.toggle('text-muted', !isError);
  }

  function clearPreview() {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    preview?.classList.add('hidden');
    if (previewImage) previewImage.removeAttribute('src');
    if (uploadButton) uploadButton.disabled = true;
  }

  fileInput?.addEventListener('change', () => {
    clearPreview();
    const file = fileInput.files?.[0];
    if (!file) {
      setStatus('Choose an image to preview it before uploading.');
      return;
    }
    if (!allowedTypes.has(file.type)) {
      setStatus('Use a JPEG, PNG, or WebP image.', true);
      return;
    }
    if (file.size === 0 || file.size > maxBytes) {
      setStatus('Images must be non-empty and 5 MB or smaller.', true);
      return;
    }

    previewUrl = URL.createObjectURL(file);
    const probe = new Image();
    probe.onload = () => {
      imageWidth = probe.naturalWidth;
      imageHeight = probe.naturalHeight;
      if (
        imageWidth < 640 ||
        imageHeight < 360 ||
        imageWidth > 8000 ||
        imageHeight > 8000
      ) {
        clearPreview();
        setStatus(
          'Use an image at least 640 × 360 pixels with no side above 8,000 pixels.',
          true,
        );
        return;
      }
      if (previewImage && previewUrl) {
        previewImage.src = previewUrl;
        previewImage.alt = altInput?.value.trim() || 'Selected image preview';
        previewImage.width = imageWidth;
        previewImage.height = imageHeight;
      }
      if (previewCaption) {
        previewCaption.textContent = `${file.name} · ${imageWidth} × ${imageHeight} pixels`;
      }
      preview?.classList.remove('hidden');
      if (uploadButton) uploadButton.disabled = false;
      setStatus('Preview ready. Confirm the alt text, then upload.');
    };
    probe.onerror = () => {
      clearPreview();
      setStatus('This file could not be read as an image.', true);
    };
    probe.src = previewUrl;
  });

  altInput?.addEventListener('input', () => {
    if (previewImage) {
      previewImage.alt = altInput.value.trim() || 'Selected image preview';
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!fileInput?.files?.[0] || !uploadButton) return;

    uploadButton.disabled = true;
    uploadButton.textContent = 'Uploading…';
    setStatus('Uploading the test image…');

    try {
      const response = await fetch('/admin/storage/upload', {
        method: 'POST',
        body: new FormData(form),
      });
      if (response.redirected) {
        window.location.assign(response.url);
        return;
      }
      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload.error || 'The upload could not be completed.');
      }

      uploadedPath = payload.path;
      if (resultPath) resultPath.textContent = payload.path;
      if (resultUrl) resultUrl.href = payload.publicUrl;
      if (resultImage) {
        resultImage.src = payload.publicUrl;
        resultImage.alt =
          altInput?.value.trim() || 'Uploaded catalogue image';
        resultImage.width = imageWidth;
        resultImage.height = imageHeight;
      }
      result?.classList.remove('hidden');
      setStatus('The test image was uploaded successfully.');
      result?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (error) {
      setStatus(
        error instanceof Error
          ? error.message
          : 'The upload could not be completed.',
        true,
      );
    } finally {
      uploadButton.disabled = false;
      uploadButton.textContent = 'Upload test image';
    }
  });

  deleteButton?.addEventListener('click', async () => {
    if (!uploadedPath || !deleteButton) return;
    deleteButton.disabled = true;
    deleteButton.textContent = 'Deleting…';
    setStatus('Deleting the test upload…');

    try {
      const response = await fetch('/admin/storage/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: uploadedPath }),
      });
      if (response.redirected) {
        window.location.assign(response.url);
        return;
      }
      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload.error || 'The image could not be deleted.');
      }

      uploadedPath = null;
      result?.classList.add('hidden');
      if (resultImage) resultImage.removeAttribute('src');
      setStatus(payload.message);
    } catch (error) {
      setStatus(
        error instanceof Error
          ? error.message
          : 'The image could not be deleted.',
        true,
      );
    } finally {
      deleteButton.disabled = false;
      deleteButton.textContent = 'Delete test upload';
    }
  });

  window.addEventListener('pagehide', () => {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
  });
</script>
