---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';

export const prerender = false;

const supabase = Astro.locals.supabase;
let errorMessage: string | undefined;
const code = Astro.url.searchParams.get('code');

if (supabase && code && Astro.request.method === 'GET') {
  const { error } = await supabase.auth.exchangeCodeForSession(code);

  if (error) {
    errorMessage =
      'This password-reset link is invalid or has expired. Request a new one.';
  }
}

let recoveryReady = false;

if (supabase && !errorMessage) {
  const {
    data: { user },
  } = await supabase.auth.getUser();
  recoveryReady = Boolean(user);
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = String(formData.get('password') ?? '');
  const confirmation = String(formData.get('passwordConfirmation') ?? '');

  if (!supabase) {
    errorMessage =
      'Password recovery is not configured for this environment.';
  } else {
    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      errorMessage =
        'Your recovery session is missing or expired. Request a new reset link.';
    } else if (password.length < 12) {
      errorMessage = 'Use a password containing at least 12 characters.';
    } else if (password !== confirmation) {
      errorMessage = 'The password confirmation does not match.';
    } else {
      const { error } = await supabase.auth.updateUser({ password });

      if (error) {
        errorMessage =
          'The password could not be updated. Request a new reset link and try again.';
      } else {
        await supabase.auth.signOut();
        return Astro.redirect('/admin/login?message=password-updated', 303);
      }
    }
  }
}
---

<AdminAuthLayout
  title="Choose a new administrator password | ExperienceHub"
  description="Set a new password for an ExperienceHub administrator account."
  eyebrow="Secure reset"
  heading="Choose a new password."
  introduction="Use a unique password with at least 12 characters."
>
  {
    errorMessage && (
      <div class="rounded-xl border border-error/35 bg-error/8 p-4 text-sm leading-6 text-error" role="alert">
        {errorMessage}
      </div>
    )
  }

  {
    recoveryReady ? (
      <form class="mt-7 space-y-5" method="post">
        <div>
          <label class="block text-sm font-semibold" for="password">
            New password
          </label>
          <input
            class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-4 text-ink"
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="12"
            required
          />
        </div>
        <div>
          <label class="block text-sm font-semibold" for="passwordConfirmation">
            Confirm new password
          </label>
          <input
            class="mt-2 min-h-12 w-full rounded-xl border border-line bg-background px-4 text-ink"
            id="passwordConfirmation"
            name="passwordConfirmation"
            type="password"
            autocomplete="new-password"
            minlength="12"
            required
          />
        </div>
        <button class="button button--primary w-full" type="submit">
          Update password
        </button>
      </form>
    ) : (
      <div class="mt-7 rounded-xl border border-line bg-background p-5">
        <p class="text-sm leading-6 text-muted">
          Open the secure link from your password-reset email to continue.
        </p>
      </div>
    )
  }

  <a class="text-link mt-7" href="/admin/forgot-password">
    Request another reset link
  </a>
</AdminAuthLayout>
