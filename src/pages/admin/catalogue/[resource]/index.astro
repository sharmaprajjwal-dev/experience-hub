---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {
  getParentOptions,
  isCatalogueResource,
  listAdminRecords,
  resourceLabels,
} from '../../../../lib/admin-catalogue';

export const prerender = false;

const resourceParam = Astro.params.resource;
if (!isCatalogueResource(resourceParam)) {
  return Astro.redirect('/admin', 302);
}
const resource = resourceParam;
const supabase = Astro.locals.supabase!;
let records = [];
let loadError: string | null = null;
let parentNames = new Map<string, string>();

try {
  records = await listAdminRecords(supabase, resource);
  const parentOptions = await getParentOptions(supabase, resource);
  parentNames = new Map(parentOptions.map(({ id, name }) => [id, name]));
} catch (error) {
  loadError =
    error instanceof Error ? error.message : 'The catalogue could not be loaded.';
}

const labels = resourceLabels[resource];
const parentKey = {
  countries: '',
  restaurants: 'country_id',
  experiences: 'restaurant_id',
  packages: 'experience_id',
}[resource];
const success = Astro.url.searchParams.get('success');
const successMessage = {
  created: `${labels.singular} created successfully.`,
  updated: `${labels.singular} updated successfully.`,
  deleted: `${labels.singular} deleted successfully.`,
}[success ?? ''];
---

<AdminLayout
  title={labels.plural}
  description={`Manage ExperienceHub ${labels.plural.toLowerCase()}.`}
  current={resource}
>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow">Catalogue</p>
      <h1 class="mt-4 font-display text-5xl tracking-[-0.04em]">
        {labels.plural}
      </h1>
      <p class="mt-4 text-muted">
        {resource === 'packages'
          ? 'Manage pricing, inclusions, booking state, and featured packages.'
          : resource === 'experiences'
            ? 'Manage experience content, restaurant relationships, and visibility.'
            : `Manage the ${labels.plural.toLowerCase()} that support the catalogue.`}
      </p>
    </div>
    <a
      class="button button--primary"
      href={`/admin/catalogue/${resource}/new`}
    >
      Add {labels.singular.toLowerCase()}
    </a>
  </div>

  {
    successMessage && (
      <div class="mt-8 rounded-xl border border-success/30 bg-success/5 p-4 text-sm text-success" role="status">
        {successMessage}
      </div>
    )
  }
  {
    loadError && (
      <div class="mt-8 rounded-xl border border-error/30 bg-error/5 p-4 text-sm text-error" role="alert">
        {loadError} Apply the latest database migration if this is a new setup.
      </div>
    )
  }

  <section class="mt-9 overflow-hidden rounded-[1.5rem] border border-line bg-surface">
    {
      records.length > 0 ? (
        <ul class="divide-y divide-line">
          {records.map((record) => (
            <li class="grid gap-4 p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-7">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="truncate font-semibold">{record.name}</h2>
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-[0.65rem] font-bold uppercase',
                      record.active
                        ? 'bg-success/10 text-success'
                        : 'bg-background text-muted',
                    ]}
                  >
                    {record.active ? 'Active' : 'Inactive'}
                  </span>
                  {record.featured && (
                    <span class="rounded-full bg-accent/10 px-2.5 py-1 text-[0.65rem] font-bold text-accent uppercase">
                      Featured
                    </span>
                  )}
                </div>
                <p class="mt-1 truncate text-sm text-muted">
                  /{record.slug}
                  {parentKey && record[parentKey]
                    ? ` · ${parentNames.get(String(record[parentKey])) ?? 'Parent unavailable'}`
                    : ''}
                </p>
              </div>
              <a
                class="button button--secondary"
                href={`/admin/catalogue/${resource}/${record.id}`}
              >
                Edit
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="p-10 text-center">
          <h2 class="font-display text-3xl">No {labels.plural.toLowerCase()} yet</h2>
          <p class="mt-3 text-muted">
            Add the first {labels.singular.toLowerCase()} when you are ready.
          </p>
        </div>
      )
    }
  </section>
</AdminLayout>
