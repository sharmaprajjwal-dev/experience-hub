---
import ButtonLink from '../components/ButtonLink.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="Temporary service issue | ExperienceHub"
  description="ExperienceHub encountered a temporary service issue."
  robots="noindex, nofollow"
>
  <SiteHeader />
  <main class="section-shell">
    <div class="site-container">
      <section class="mx-auto max-w-2xl rounded-[1.5rem] border border-line bg-surface p-7 sm:p-12">
        <p class="eyebrow">Temporary service issue</p>
        <h1 class="mt-5 font-display text-5xl tracking-[-0.04em]">
          We could not serve this page.
        </h1>
        <p class="mt-6 text-lg leading-8 text-muted">
          Please try again shortly. No technical details or account information
          are displayed on this public error page.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="/">Return home</ButtonLink>
          <ButtonLink href="/experiences" variant="secondary">
            Browse experiences
          </ButtonLink>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
