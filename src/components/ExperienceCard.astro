---
interface Props {
  eyebrow: string;
  title: string;
  restaurant: string;
  description: string;
  packageName: string;
  mediaClass: string;
  href: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  eyebrow,
  title,
  restaurant,
  description,
  packageName,
  mediaClass,
  href,
  imageAlt,
  imageWidth = 1600,
  imageHeight = 1200,
} = Astro.props;
const usesImage = !mediaClass.startsWith('media-');
---

<article class="card group">
  <div
    class:list={['media-frame aspect-[16/11]', !usesImage && mediaClass]}
    role={!usesImage ? 'img' : undefined}
    aria-label={!usesImage ? imageAlt ?? `Dining atmosphere for ${title}` : undefined}
  >
    {
      usesImage && (
        <img
          class="absolute inset-0 h-full w-full object-cover"
          src={mediaClass}
          alt={imageAlt ?? `Dining atmosphere for ${title}`}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span
      class="absolute top-5 left-5 z-10 rounded-full border border-white/30 bg-black/15 px-3 py-1 text-[0.68rem] font-bold tracking-[0.16em] text-white uppercase backdrop-blur-sm"
    >
      {eyebrow}
    </span>
  </div>
  <div class="p-6 sm:p-8">
    <p class="text-xs font-bold tracking-[0.16em] text-accent uppercase">
      {restaurant}
    </p>
    <h3 class="mt-3 font-display text-3xl leading-tight tracking-[-0.025em]">
      {title}
    </h3>
    <p class="mt-4 leading-7 text-muted">{description}</p>
    <div
      class="mt-6 flex flex-col gap-4 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm font-medium text-ink">{packageName}</p>
      <a class="text-link shrink-0" href={href}>View experience</a>
    </div>
  </div>
</article>
