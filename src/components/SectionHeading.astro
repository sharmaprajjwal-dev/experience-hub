---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centred?: boolean;
  level?: 'h1' | 'h2';
}

const {
  eyebrow,
  title,
  description,
  centred = false,
  level = 'h2',
} = Astro.props;
const Heading = level;
---

<div class:list={['reading-width', { 'mx-auto text-center': centred }]}>
  <p class="eyebrow">{eyebrow}</p>
  <Heading
    class="mt-4 font-display text-4xl leading-[1.08] tracking-[-0.035em] text-balance sm:text-5xl"
  >
    {title}
  </Heading>
  {
    description && (
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
        {description}
      </p>
    )
  }
</div>
