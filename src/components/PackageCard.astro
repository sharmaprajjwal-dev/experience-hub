---
import {
  formatBookingStatus,
  formatPrice,
  type PackageEntry,
} from '../lib/content';

interface Props {
  packageEntry: PackageEntry;
}

const { packageEntry } = Astro.props;
const { data } = packageEntry;
---

<article class="card flex h-full flex-col p-6 sm:p-8">
  <div class="flex items-start justify-between gap-4">
    <p class="eyebrow">{formatBookingStatus(data.bookingStatus)}</p>
    {data.featured && (
      <span class="rounded-full bg-background px-3 py-1 text-xs font-semibold text-muted">
        Featured
      </span>
    )}
  </div>
  <h3 class="mt-5 font-display text-3xl leading-tight tracking-[-0.025em]">
    {data.name}
  </h3>
  <p class="mt-4 grow leading-7 text-muted">{data.shortDescription}</p>
  <dl class="mt-7 grid grid-cols-2 gap-4 border-t border-line pt-5 text-sm">
    <div>
      <dt class="text-muted">For</dt>
      <dd class="mt-1 font-semibold">
        {data.numberOfGuests} {data.numberOfGuests === 1 ? 'guest' : 'guests'}
      </dd>
    </div>
    <div>
      <dt class="text-muted">Duration</dt>
      <dd class="mt-1 font-semibold">{data.duration}</dd>
    </div>
  </dl>
  <div class="mt-7 flex items-end justify-between gap-4">
    <p class="font-display text-2xl">
      {formatPrice(data.price, data.currency)}
    </p>
    <a class="text-link" href={`/packages/${data.slug}`}>Details</a>
  </div>
</article>
