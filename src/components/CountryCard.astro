---
interface Props {
  country: string;
  countrySlug: string;
  location: string;
  description: string;
  mediaClass: string;
  href: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  country,
  countrySlug,
  location,
  description,
  mediaClass,
  href,
  imageAlt,
  imageWidth = 1600,
  imageHeight = 1200,
} = Astro.props;
const usesImage = !mediaClass.startsWith('media-');
---

<article class="card group">
  <div
    class:list={['media-frame aspect-[4/3]', !usesImage && mediaClass]}
    role={!usesImage ? 'img' : undefined}
    aria-label={!usesImage ? imageAlt ?? `Atmosphere in ${country}` : undefined}
  >
    {
      usesImage && (
        <img
          class="absolute inset-0 h-full w-full object-cover"
          src={mediaClass}
          alt={imageAlt ?? `Atmosphere in ${country}`}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <p
      class="absolute bottom-5 left-5 z-10 text-xs font-bold tracking-[0.18em] text-white uppercase"
    >
      {location}
    </p>
  </div>
  <div class="p-6 sm:p-8">
    <h3 class="font-display text-3xl tracking-[-0.025em]">{country}</h3>
    <p class="mt-3 leading-7 text-muted">{description}</p>
    <a
      class="text-link mt-6"
      href={href}
      data-analytics-event="country_selected"
      data-analytics-country={countrySlug}
    >
      Discover {country}
    </a>
  </div>
</article>
