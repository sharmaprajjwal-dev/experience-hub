---
import '../styles/global.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { getAnalyticsConfiguration } from '../lib/analytics-config';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: URL | string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  ogImage?: URL | string;
  ogImageAlt?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'ExperienceHub | Curated dining experiences',
  description = 'Discover thoughtfully curated dining experiences and packages in remarkable destinations.',
  canonicalURL,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  ogImage = '/og.jpg',
  ogImageAlt = 'ExperienceHub Journal — considered dining guides and curated experiences',
  robots,
  structuredData,
} = Astro.props;

const canonical = canonicalURL
  ? new URL(canonicalURL, Astro.site ?? Astro.url).toString()
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : undefined;
const socialImage = new URL(ogImage, Astro.site ?? Astro.url).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData) : undefined;
const analyticsConfiguration = getAnalyticsConfiguration();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ExperienceHub Journal"
      href="/journal/rss.xml"
    />
    {
      ogType === 'article' && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      ogType === 'article' && modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      ogType === 'article' && author && (
        <meta property="article:author" content={author} />
      )
    }
    {
      jsonLd && (
        <script type="application/ld+json" set:html={jsonLd} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-background text-ink antialiased">
    <slot />
    {
      analyticsConfiguration && (
        <AnalyticsConsent configuration={analyticsConfiguration} />
      )
    }
  </body>
</html>
