---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  introduction: string;
}

const {
  title,
  description,
  eyebrow,
  heading,
  introduction,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={Astro.url.pathname}
  robots="noindex, nofollow"
>
  <main class="min-h-screen lg:grid lg:grid-cols-[0.9fr_1.1fr]">
    <section class="relative hidden overflow-hidden bg-ink p-12 text-surface lg:flex lg:flex-col lg:justify-between">
      <a
        class="relative z-10 font-display text-2xl tracking-[-0.03em]"
        href="/"
        aria-label="ExperienceHub home"
      >
        ExperienceHub
      </a>
      <div
        class="media-frame media-journal-couple absolute inset-0 opacity-35"
        aria-hidden="true"
      ></div>
      <div class="relative z-10 max-w-md">
        <p class="text-xs font-bold tracking-[0.2em] text-stone-300 uppercase">
          Private administration
        </p>
        <p class="mt-5 font-display text-5xl leading-[1.05] tracking-[-0.04em]">
          Curate thoughtful experiences with care.
        </p>
      </div>
    </section>

    <section class="flex min-h-screen items-center bg-surface px-5 py-14 sm:px-10 lg:px-16">
      <div class="mx-auto w-full max-w-md">
        <a
          class="mb-14 inline-flex items-center gap-3 font-display text-xl tracking-[-0.03em] lg:hidden"
          href="/"
          aria-label="ExperienceHub home"
        >
          <span class="grid size-9 place-items-center rounded-full bg-ink font-sans text-[0.68rem] font-bold tracking-[0.16em] text-surface">
            EH
          </span>
          ExperienceHub
        </a>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-4 font-display text-5xl leading-[1.05] tracking-[-0.04em] text-balance">
          {heading}
        </h1>
        <p class="mt-5 leading-7 text-muted">{introduction}</p>
        <div class="mt-9">
          <slot />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
